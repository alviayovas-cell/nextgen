# Internship applications are emailed through Gmail SMTP.
# SMTP_USER: the Gmail / Google Workspace address that sends the emails (e.g. info@nextgenlearners.in)
# SMTP_PASS: a 16-character Google "App password" (NOT the normal account password)
# APPLICATION_TO_EMAIL: where applications are delivered (defaults to SMTP_USER)
SMTP_USER=
SMTP_PASS=
APPLICATION_TO_EMAIL=info@nextgenlearners.in
