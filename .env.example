# Internship applications are emailed through an SMTP provider (Brevo shown below).

# Where applications are delivered
APPLICATION_TO_EMAIL=info@nextgenlearners.in

# Brevo: SMTP & API page -> SMTP tab
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# The "Login" value Brevo shows (looks like xxxx@smtp-brevo.com), NOT your account email
SMTP_USER=
# An SMTP key you generate in Brevo (not your account password)
SMTP_PASS=
# A sender address you have verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
SMTP_FROM=
