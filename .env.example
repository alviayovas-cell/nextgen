# Internship applications are emailed through an SMTP provider (Brevo shown below).

# Optional: a real Nexora community invitation / registration link. When set, a "Join Community" button appears on /community.
NEXT_PUBLIC_COMMUNITY_URL=

# Where applications are delivered
APPLICATION_TO_EMAIL=nextgencontacts06@gmail.com

# To send through Gmail instead of Brevo, use: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=nextgencontacts06@gmail.com, SMTP_FROM=nextgencontacts06@gmail.com, and set SMTP_PASS to a
# Google App Password (Google Account -> Security -> 2-Step Verification -> App passwords), not the account password.

# Brevo: SMTP & API page -> SMTP tab
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# The "Login" value Brevo shows (looks like xxxx@smtp-brevo.com), NOT your account email
SMTP_USER=
# An SMTP key you generate in Brevo (not your account password)
SMTP_PASS=
# A sender address you have verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
SMTP_FROM=
